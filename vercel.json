{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "cyberrisk-ai": {
      "root": ".",
      "entrypoint": "api.vc_app:app",
      "buildCommand": "cd app/frontend && npm ci && npm run build"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "cyberrisk-ai" } }
  ]
}
