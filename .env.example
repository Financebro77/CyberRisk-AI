# =====================================================================
# CyberRisk AI — Environment configuration template
# =====================================================================
#
# Copy this file to `.env` and fill in YOUR keys.  Never commit the real
# `.env` — it is gitignored (see .gitignore).  If a real key is ever
# committed accidentally, rotate it immediately: it is compromised.
#
#   cp .env.example .env        (bash / macOS / Linux)
#   Copy-Item .env.example .env (PowerShell)
#
# All secrets are read from the environment (or the `.env` file) at
# runtime via python-dotenv — nothing is hard-coded in the source tree.
#
# LEAVE THE VALUES BELOW EMPTY.  The placeholders are documentation only.

# ----------------------------------------------------------------------
# LLM provider selection
# ----------------------------------------------------------------------
# The AI consultant layer can run on either supported provider.  Set this
# to "openai" or "deepseek".  If left blank, the provider is inferred from
# whichever key is present in the environment (OpenAI takes precedence if
# both are set).
#
#   LLM_PROVIDER=deepseek   -> uses DEEPSEEK_API_KEY
#   LLM_PROVIDER=openai     -> uses OPENAI_API_KEY
LLM_PROVIDER=openai

# ----------------------------------------------------------------------
# Required for the OpenAI provider (https://platform.openai.com)
# Used when LLM_PROVIDER=openai.  Supports GPT models (gpt-4o, gpt-4o-mini,
# o-series, ...) via the OpenAI chat-completions API.
# ----------------------------------------------------------------------
OPENAI_API_KEY=

# Optional — model to use (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional — override the API endpoint (e.g. a compatible gateway / proxy)
# OPENAI_BASE_URL=

# ----------------------------------------------------------------------
# Required for the DeepSeek provider (https://platform.deepseek.com)
# Used when LLM_PROVIDER=deepseek.  The AI consultant layer uses DeepSeek
# via the OpenAI-compatible SDK.
# ----------------------------------------------------------------------
DEEPSEEK_API_KEY=

# Optional — override the API endpoint (default https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional — model to use (default deepseek-chat; deepseek-reasoner for R1)
# DEEPSEEK_MODEL=deepseek-chat

# ----------------------------------------------------------------------
# Optional — Anthropic API key
# Only needed if you use an Anthropic model via a compatible gateway.
# Leave blank for the default DeepSeek / OpenAI integration.
# ----------------------------------------------------------------------
# ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------
# Optional — API security (production hardening)
# Opt-in: leave unset for the default open local/dev API.
# ----------------------------------------------------------------------
# When set, every /api/* route requires `Authorization: Bearer <key>`.
# Never commit a real key; inject via the environment at deploy time.
# CYBERRISK_API_KEY=

# Requests per minute per client IP when > 0 (0 = disabled).  In-memory
# sliding window — single process only.
# CYBERRISK_RATE_LIMIT=60

# ----------------------------------------------------------------------
# Optional — database / datastore credentials (reserved)
# Uncomment and set only if you run the persistence-backed deployment.
# ----------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=cyberrisk
# DB_USER=postgres
# DB_PASSWORD=
